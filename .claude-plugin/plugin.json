{
  "name": "nebius",
  "version": "1.3.0",
  "description": "Nebius models, cloud sandboxes, a SafeCode session type and Tavily web search in Velloc.",
  "author": {
    "name": "Velloc"
  },
  "license": "MIT",
  "keywords": [
    "mod",
    "provider",
    "nebius",
    "sandbox",
    "mcp"
  ],
  "requires": {
    "providers": [
      "token-factory"
    ],
    "features": [
      "template-mcp-scope"
    ]
  },
  "templates": {
    "safecode": {
      "title": {
        "en": "SafeCode",
        "zh-CN": "SafeCode"
      },
      "description": {
        "en": "Edit locally, run everything in Nebius sandboxes. Nothing you ask for runs on this computer.",
        "zh-CN": "本地只改文件，一切运行都在 Nebius 沙箱里；本机不会执行你要求的任何东西。"
      },
      "icon": "./icon.svg",
      "launcher": "both"
    }
  },
  "providers": {
    "token-factory": {
      "providerApi": 1,
      "displayName": {
        "en": "Nebius"
      },
      "icon": "./icon.svg",
      "defaultBaseUrl": "https://api.tokenfactory.nebius.com/v1",
      "domains": [
        "nebius.com"
      ],
      "format": "openai-chat",
      "credentials": {
        "methods": [
          "apiKey"
        ],
        "prompts": [
          {
            "type": "text",
            "key": "api_key",
            "message": {
              "de": "API-Schlüssel",
              "en": "API key",
              "es": "Clave de API",
              "fr": "Clé API",
              "ja": "API キー",
              "ko": "API 키",
              "zh-CN": "API 密钥"
            },
            "placeholder": {
              "de": "Nebius-API-Schlüssel eingeben",
              "en": "Enter your Nebius API key",
              "es": "Introduce tu clave de API de Nebius",
              "fr": "Saisissez votre clé API Nebius",
              "ja": "Nebius API キーを入力",
              "ko": "Nebius API 키 입력",
              "zh-CN": "输入 Nebius API 密钥"
            },
            "secret": true
          }
        ],
        "secrets": [
          {
            "name": "tavily_api_key",
            "label": {
              "en": "Tavily API key",
              "zh-CN": "Tavily 密钥",
              "de": "Tavily-API-Schlüssel",
              "es": "Clave de API de Tavily",
              "fr": "Clé API Tavily",
              "ja": "Tavily API キー",
              "ko": "Tavily API 키"
            },
            "hint": {
              "de": "Optional · Websuche",
              "en": "Optional · Web search",
              "es": "Opcional · Búsqueda web",
              "fr": "Facultatif · Recherche web",
              "ja": "任意 · ウェブ検索",
              "ko": "선택 사항 · 웹 검색",
              "zh-CN": "可选 · 联网搜索"
            }
          }
        ]
      },
      "modelsUi": {
        "intro": {
          "de": "Modelle mit Tool-Unterstützung",
          "en": "Models with tool support",
          "es": "Modelos con uso de herramientas",
          "fr": "Modèles compatibles avec les outils",
          "ja": "ツール呼び出し対応モデル",
          "ko": "도구 호출 지원 모델",
          "zh-CN": "支持工具调用的模型"
        },
        "empty": {
          "de": "API-Schlüssel speichern, um Modelle zu laden.",
          "en": "Save your API key to load models.",
          "es": "Guarda tu clave de API para cargar los modelos.",
          "fr": "Enregistrez votre clé API pour charger les modèles.",
          "ja": "API キーを保存するとモデルが表示されます。",
          "ko": "API 키를 저장하면 모델이 표시됩니다.",
          "zh-CN": "保存 API 密钥后加载模型。"
        },
        "links": [
          {
            "label": {
              "en": "Get an API key",
              "zh-CN": "获取 API 密钥",
              "ja": "API キーを取得",
              "ko": "API 키 받기",
              "es": "Obtener una clave de API",
              "fr": "Obtenir une clé API",
              "de": "API-Schlüssel erstellen"
            },
            "url": "https://tokenfactory.nebius.com/"
          },
          {
            "label": {
              "de": "Dokumentation",
              "en": "Docs",
              "es": "Documentación",
              "fr": "Documentation",
              "ja": "ドキュメント",
              "ko": "문서",
              "zh-CN": "文档"
            },
            "url": "https://docs.tokenfactory.nebius.com/"
          }
        ],
        "tags": {
          "fast": {
            "label": {
              "en": "Fast",
              "zh-CN": "快速",
              "ja": "高速",
              "ko": "빠름",
              "es": "Rápido",
              "fr": "Rapide",
              "de": "Schnell"
            }
          },
          "reasoning": {
            "label": {
              "en": "Reasoning",
              "zh-CN": "推理",
              "ja": "推論",
              "ko": "추론",
              "es": "Razonamiento",
              "fr": "Raisonnement",
              "de": "Reasoning"
            }
          },
          "vision": {
            "label": {
              "en": "Vision",
              "zh-CN": "视觉",
              "ja": "画像入力",
              "ko": "비전",
              "es": "Visión",
              "fr": "Vision",
              "de": "Bildeingabe"
            }
          }
        },
        "filters": [
          "reasoning",
          "vision",
          "fast"
        ],
        "customModels": {
          "formats": [
            "openai-chat"
          ],
          "wires": {
            "openai-chat": {
              "compat": {
                "maxTokensField": "max_tokens",
                "developerRole": false
              }
            }
          }
        },
        "starterModels": [
          "nvidia/Nemotron-3-Ultra-550b-a55b",
          "nvidia/Nemotron-3.5-Super-VL",
          "nvidia/Nemotron-3_5-Lightning",
          "deepseek-ai/DeepSeek-V4.1-Flash"
        ],
        "tierModels": {
          "best": "nvidia/Nemotron-3-Ultra-550b-a55b",
          "balanced": "nvidia/Nemotron-3.5-Super-VL",
          "fast": "nvidia/Nemotron-3_5-Lightning"
        }
      },
      "module": "./providers/nebius.js",
      "settings": {
        "project_id": {
          "type": "string",
          "title": {
            "en": "Project ID",
            "zh-CN": "项目 ID",
            "de": "Projekt-ID",
            "es": "ID del proyecto",
            "fr": "ID du projet",
            "ja": "プロジェクト ID",
            "ko": "프로젝트 ID"
          },
          "description": {
            "de": "Nur für Sandboxes",
            "en": "For sandboxes only",
            "es": "Solo para entornos aislados",
            "fr": "Pour les environnements isolés uniquement",
            "ja": "サンドボックス用",
            "ko": "샌드박스 전용",
            "zh-CN": "仅用于沙箱"
          }
        }
      }
    }
  },
  "userConfig": {
    "default_image": {
      "type": "string",
      "title": "Default image",
      "description": "The image a run, a lane or a test matrix uses when none is named: an image UUID or tag:<name>, e.g. tag:python:3.12.",
      "default": "tag:python:3.12"
    },
    "max_run_seconds": {
      "type": "number",
      "title": "Longest run (seconds)",
      "description": "A run asking for a longer timeout is cut to this.",
      "default": 1800,
      "min": 30,
      "max": 86400
    },
    "auto_approve_remote": {
      "type": "boolean",
      "title": "Approve remote-only sandbox tools",
      "description": "Run the contree tools that touch only the sandbox (run, images, operations, reading files inside an image) without asking. Tools that read or write local files (rsync, upload, download) always ask. Needed for background sub-agents, which cannot ask.",
      "default": false
    }
  }
}
